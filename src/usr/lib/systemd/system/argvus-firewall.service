[Unit]
Description=ARGVUS Firewall
After=network.target
After=syslog.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/argvus/commands/argvus-firewall on
ExecReload=/usr/lib/argvus/commands/argvus-firewall on
ExecStop=/usr/lib/argvus/commands/argvus-firewall off

[Install]
WantedBy=multi-user.target
