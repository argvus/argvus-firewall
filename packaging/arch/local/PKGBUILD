# Maintainer: William C. Canin
pkgname=argvus-firewall
pkgver=0.1.0
pkgrel=1
pkgdesc="iptables-based firewall management tool for the ARGVUS desktop."
arch=('any')
url="https://github.com/argvus/argvus-firewall"
license=('GPL-3.0-only')
depends=('iptables' 'systemd' 'python' 'polkit')
optdepends=('nano: default editor used by the config and rules subcommands')
install=argvus-firewall.install
backup=(
  'etc/argvus/firewall/config.conf'
  'etc/argvus/firewall/rules.fw'
)
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=()

# shellcheck disable=SC1091
_functions_file="${startdir:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/../common/functions.sh"
. "$_functions_file"

prepare() {
  arch_normalize_source_tree
}

check() {
  arch_check_firewall_payload
}

package() {
  arch_package_firewall_payload
}
